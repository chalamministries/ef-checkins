{
  "build": {
    "devPath": "../src",
    "distDir": "../src"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": false
      },
      "http": {
        "all": false,
        "request": true
      },
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["windows/nsis"],
      "identifier": "com.elevationfitness.checkins",
      "icon": [
        "../assets/icons/32x32.png",
        "../assets/icons/128x128.png",
        "../assets/icons/256x256.png"
      ]
    },
    "window": {
      "title": "EF Checkins",
      "width": 598,
      "height": 938,
      "resizable": false,
      "fullscreen": false,
      "decorations": false,
      "alwaysOnTop": true,
      "visible": true,
      "center": true,
      "focus": true,
      "skipTaskbar": true,
      "theme": "light",
      "transparent": false
    }
  }
}
