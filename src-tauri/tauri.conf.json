{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EF Checkins",
  "version": "2.0.0",
  "identifier": "com.elevationfitness.checkins",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EF Checkins",
        "width": 598,
        "height": 938,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": true,
        "center": true,
        "focus": true,
        "skipTaskbar": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}