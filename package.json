{
  "name": "ef-checkins",
  "version": "1.0.0",
  "description": "EF Checkins Kiosk App - Real-time Faye-powered attendance display",
  "main": "main.js",
  "author": "EF Kiosk Team",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "build:msi": "electron-builder build --win msi"
  },
  "dependencies": {
    "faye": "^1.4.0"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "electron": "^33.0.0",
    "electron-builder": "25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.elevationfitness.checkins",
    "productName": "EF Checkins",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "msi"],
      "icon": "assets/icons/256x256.png",
      "publisherName": "EF Kiosk Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
