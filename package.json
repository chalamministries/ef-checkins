{
  "name": "ef-checkins",
  "version": "1.0.0",
  "description": "EF Checkins Kiosk App - Real-time Faye-powered attendance display",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "build:msi": "electron-builder build --win msi"
  },
  "dependencies": {
    "faye": "^1.4.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.elevationfitness.checkins",
    "productName": "EF Checkins",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "assets/icons/256x256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
